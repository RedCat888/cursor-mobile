{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursor-mobile-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR_DO",
        "class_name": "PairDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairDO"]
    }
  ]
}
