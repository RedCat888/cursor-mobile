{
  "name": "cursor-mobile-daemon",
  "version": "0.1.0",
  "description": "Local daemon that lets the Cursor Mobile Android app drive Cursor on your Mac.",
  "type": "module",
  "private": true,
  "bin": {
    "cursor-mobile-daemon": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts run",
    "start": "node dist/cli.js run",
    "pair": "tsx src/cli.ts pair",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@connectrpc/connect-node": "^2.1.2",
    "@cursor/sdk": "^1.0.19",
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "chokidar": "^3.6.0",
    "fastify": "^4.28.0",
    "node-pty": "^1.0.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "qrcode-terminal": "^0.12.0",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
