<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cursormobile.submit-helper</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HELPER_BIN__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.cursor-mobile/submit-helper.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.cursor-mobile/submit-helper.err.log</string>

  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
